{
  "store": "iCloud Drive/SYNC",
  "state": "~/Documents/NoteSync",
  "engine_dir": "~/notesync",
  "poll_apple_seconds": 120,
  "poll_evernote_seconds": 300,
  "gdrive_mirror": null,
  "gdrive_enabled": false,
  "probe_apple_folder": "NoteSync-Probe",
  "probe_en_notebook": "NoteSync-Probe",
  "mail_import": {
    "enabled": false,
    "address": "notes-inbox@example.com",
    "account": "iCloud",
    "mailbox": "INBOX",
    "include_bcc": true,
    "lookback_days": 1,
    "allowed_senders": [],
    "notes_account": "",
    "notes_folder": "",
    "after_import": "move",
    "done_mailbox": "NoteSync",
    "max_attachment_mb": 50
  },
  "mappings": [
    {
      "name": "sync",
      "folder": "",
      "apple_folder": "SYNC",
      "apple_enabled": true,
      "en_notebook": "SYNC",
      "en_enabled": true
    }
  ]
}
